<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.foliox</groupId>
  <artifactId>foliox-parent</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>

  <name>Foliox Parent</name>
  <description>Foliox v2 - microservicios de asistencia juridica</description>

  <modules>
    <module>foliox-common</module>
    <module>foliox-gateway</module>
    <module>foliox-auth</module>
    <module>foliox-usuarios</module>
    <module>foliox-expedientes</module>
    <module>foliox-documentos</module>
    <module>foliox-agenda</module>
    <module>foliox-notificaciones</module>
  </modules>

  <properties>
    <java.version>25</java.version>
    <maven.compiler.release>25</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <spring-boot.version>4.1.0</spring-boot.version>
    <springdoc.version>3.1.0</springdoc.version>
    <!-- 1.18.40 added JDK 25 support; 1.18.44 fixed JDK 25 javac bugs; 1.18.46 is current stable -->
    <lombok.version>1.18.46</lombok.version>
    <!-- JDK 23+ disables implicit annotation processing; required for Lombok to run -->
    <maven.compiler.proc>full</maven.compiler.proc>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-dependencies</artifactId>
        <version>${spring-boot.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>org.springdoc</groupId>
        <artifactId>springdoc-openapi-starter-webflux-ui</artifactId>
        <version>${springdoc.version}</version>
      </dependency>
      <dependency>
        <groupId>com.foliox</groupId>
        <artifactId>foliox-common</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>org.projectlombok</groupId>
        <artifactId>lombok</artifactId>
        <version>${lombok.version}</version>
        <scope>provided</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>3.14.0</version>
          <configuration>
            <release>${maven.compiler.release}</release>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.springframework.boot</groupId>
          <artifactId>spring-boot-maven-plugin</artifactId>
          <version>${spring-boot.version}</version>
          <!-- Parent does NOT use spring-boot-starter-parent, so the repackage
               execution is not inherited automatically; bind it here so every
               child that declares the plugin produces an executable fat jar. -->
          <executions>
            <execution>
              <goals>
                <goal>repackage</goal>
              </goals>
            </execution>
          </executions>
        </plugin>
      </plugins>
    </pluginManagement>
  </build>
</project>
