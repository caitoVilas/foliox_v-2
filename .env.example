# Foliox local stack — environment variables
# Copy to .env to override any value; every value below IS the default used
# by docker-compose.yml, so an empty .env (or none at all) works out of the box.
# NEVER commit .env (it is already in .gitignore).

# --- PostgreSQL (localhost:5432) ---
# Superuser for all 6 service databases created by infra/postgres/init/.
POSTGRES_USER=foliox
POSTGRES_PASSWORD=foliox

# --- MinIO (localhost:9000 API, localhost:9001 console) ---
# Root user for the MinIO server. MINIO requires passwords of at least 8 characters.
MINIO_ROOT_USER=foliox
MINIO_ROOT_PASSWORD=foliox12345
# Bucket where the documentos service stores PDFs. Created automatically on
# startup (idempotent) via the image's native MINIO_DEFAULT_BUCKETS support.
MINIO_DEFAULT_BUCKET=documentos

# --- Kafka ---
# No credentials. Fixed endpoints (not configurable):
#   host clients        -> localhost:9092
#   in-network clients  -> kafka:19092
