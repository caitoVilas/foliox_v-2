# Foliox environment variables — template
# ---------------------------------------------------------------
# Copy this file to .env and replace the placeholder values:
#     Copy-Item .env.example .env
# .env is gitignored: NEVER commit it. It holds real credentials.
# All services and docker-compose read these variables at boot;
# secrets have no fallback defaults, so a missing var fails fast.
# ---------------------------------------------------------------

POSTGRES_USER=foliox
POSTGRES_PASSWORD=changeme-strong-password

MINIO_ROOT_USER=foliox
MINIO_ROOT_PASSWORD=changeme-minio-password
MINIO_DEFAULT_BUCKET=documentos

# OAuth2 client secret for foliox-web (auth service).
# Required with NO fallback: an empty secret would silently downgrade the
# client to a "public" client (client_id checked, secret ignored).
# Generate one: -join ((48..57)+(65..90)+(97..122) | Get-Random -Count 32 | %{[char]$_})
FOLIOX_CLIENT_SECRET=changeme-oauth-client-secret
